# Runtime droppings, all machine-local:
#   logs/logs/   — nudge_inject.log (injector stdout/stderr tee)
#   logs/states/ — incremental-render state (conversation tail, memory
#                  sections) plus the X notification counter
logs/

# CC-touched signal telling the monitor its X notifications were handled.
# Lives in the project root on purpose — the docs tell CC to touch it there.
x_notif_ack

# Local media staging for gemini-video MCP (uploads copied here for D:-side access)
temp_media/

# CC-written one-shot request: scheduler sends /compact next idle gap
request_compact

# CC's private room (journal + project threads) — personal, stays local.
# Ignore contents but keep the setup templates tracked.
mind/*
!mind/journal.template.md
!mind/projects.template.md

# Codex (OpenAI CLI agent) scratch — unrelated to this project
.codex/
